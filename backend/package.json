    "form-data": "4.0.1",
    "pg": "8.13.3",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
