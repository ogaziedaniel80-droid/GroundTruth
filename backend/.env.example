# GroundTruth Backend — environment configuration
#
# Copy this file to .env and fill in the values for your environment.
# Never commit .env — it is in .gitignore.

# ── Stellar / Soroban ───────────────────────────────────────────────────────
# RPC endpoint for the target network.
# Testnet:    https://soroban-testnet.stellar.org
# Futurenet:  https://rpc-futurenet.stellar.org
# Mainnet:    https://mainnet.stellar.validationcloud.io/v1/<key>
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase — must match the RPC_URL network.
# Testnet:  "Test SDF Network ; September 2015"
# Futurenet:"Test SDF Future Network ; October 2022"
# Mainnet:  "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed contract ID (C... address returned by scripts/deploy.sh)
LAND_REGISTRY_CONTRACT_ID=

# Secret key for the backend service account (used to sign register_title txs
# on behalf of an authorized registrar in the dev/CI smoke-test path only).
# In production, registrars sign client-side via Freighter — the backend does
# NOT custody private keys for registrars.  See README "Trust & security model".
BACKEND_SECRET_KEY=

# ── IPFS / off-chain storage ────────────────────────────────────────────────
# Pinata credentials for IPFS pinning (https://app.pinata.cloud)
# Alternatively set STORAGE_PROVIDER=s3 and configure S3_* vars below.
STORAGE_PROVIDER=pinata
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# S3-compatible object storage (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string for the event indexer read-cache.
# This DB is NOT the source of truth — the chain is. The indexer populates it
# from on-chain events; see src/indexer/ and README "Development workflow".
DATABASE_URL=postgresql://groundtruth:groundtruth@localhost:5432/groundtruth

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info

# ── Indexer ─────────────────────────────────────────────────────────────────
# How often (ms) the indexer polls Soroban RPC getEvents.
INDEXER_POLL_INTERVAL_MS=5000
# Starting ledger for event replay (0 = latest; set to a historical ledger to
# replay from genesis of the deployed contract).
INDEXER_START_LEDGER=0
